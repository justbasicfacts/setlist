# Upcoming shows per city. https://developer.ticketmaster.com/
# Create an account -> "Get your API key" -> copy the Consumer Key.
TICKETMASTER_API_KEY=

# Track lookup for the playlist. https://developer.spotify.com/dashboard
# Create app -> copy Client ID and Client secret.
# The secret is only read by the dev server (see vite.config.ts); it never reaches
# the browser, and a production build needs a backend to hold it instead.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
