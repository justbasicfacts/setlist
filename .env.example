# Upcoming shows per city. https://developer.ticketmaster.com/
# My Apps -> your app -> Consumer Key.
TICKETMASTER_API_KEY=

# Playlists are created in the visitor's own account, so Spotify needs the client id
# and this redirect URI registered in the app (dashboard -> Edit settings):
#   http://localhost:5180/
# No client secret is used: authorisation is PKCE, in the browser.
SPOTIFY_CLIENT_ID=
