# Ticketmaster Discovery API key. https://developer.ticketmaster.com/ -> My Apps
TICKETMASTER_API_KEY=

# Comma separated list of sites allowed to call the API. The first is the fallback.
SITE_ORIGIN=http://localhost:5180

# Where the built site looks for the API. Empty in development.
# VITE_API_BASE=https://your-api.onrender.com
